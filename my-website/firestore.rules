rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && (
          request.auth.uid == "M3GxGOkF9ZWoezkICNpvS5ID1Hz2"
          || (
            request.auth.token.email != null
            && request.auth.token.email == "emviemsalva@gmail.com"
          )
        );
    }

    function adminPath() {
      return /databases/$(database)/documents/cineflexAdmins/$(request.auth.uid);
    }

    function hasAdminRole(roles) {
      return signedIn() && (
        isOwner()
        || (
          exists(adminPath())
          && get(adminPath()).data.active == true
          && get(adminPath()).data.role in roles
        )
      );
    }

    function isAdmin() {
      return hasAdminRole([
        "super_admin",
        "moderator",
        "support",
        "content_manager"
      ]);
    }

    function isSuperAdmin() {
      return isOwner() || hasAdminRole(["super_admin"]);
    }

    // Main account records used by Admin Studio user search and counters.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isSuperAdmin();

      match /profiles/{profileId} {
        allow read, create, update, delete:
          if signedIn() && request.auth.uid == uid;
      }

      match /watchProgress/{progressId} {
        allow read, create, update, delete:
          if signedIn() && request.auth.uid == uid;
      }

      match /watchTime/{documentId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        // The current website deducts and rewards time client-side; admins can edit any balance.
        allow create, update: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow delete: if isAdmin();
      }

      match /dailyReward/{documentId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn()
          && request.auth.uid == uid
          && documentId == "status"
          && request.resource.data.streak == 1
          && request.resource.data.best == 1
          && request.resource.data.claimed == false
          && request.resource.data.membershipApplied == false
          && request.resource.data.lastCheckIn == request.time;
        allow update: if signedIn()
          && request.auth.uid == uid
          && documentId == "status"
          && request.resource.data.streak is int
          && request.resource.data.streak >= 1
          && request.resource.data.streak <= 30
          && request.resource.data.best is int
          && request.resource.data.best >= resource.data.best
          && request.resource.data.lastCheckIn == request.time
          && (
            (
              request.resource.data.claimed == resource.data.claimed
              && request.resource.data.membershipApplied == resource.data.membershipApplied
              && request.time > resource.data.lastCheckIn + duration.value(20, 'h')
              && request.time < resource.data.lastCheckIn + duration.value(48, 'h')
              && request.resource.data.streak == resource.data.streak + 1
            )
            ||
            (
              request.resource.data.claimed == resource.data.claimed
              && request.resource.data.membershipApplied == resource.data.membershipApplied
              && request.time >= resource.data.lastCheckIn + duration.value(48, 'h')
              && request.resource.data.streak == 1
            )
            ||
            (
              resource.data.streak >= 30
              && resource.data.membershipApplied == false
              && request.resource.data.streak == resource.data.streak
              && request.resource.data.claimed == true
              && request.resource.data.membershipApplied == true
              && request.resource.data.claimedAt == request.time
            )
          );
        allow delete: if isSuperAdmin();
      }

      match /membership/{documentId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if isSuperAdmin()
          || (
            signedIn()
            && request.auth.uid == uid
            && documentId == "status"
            && request.resource.data.plan == "vip"
            && request.resource.data.vip == true
            && request.resource.data.active == true
            && request.resource.data.source == "30-day-login-reward"
            && request.resource.data.vipExpiry > request.time + duration.value(29, 'd')
            && request.resource.data.vipExpiry < request.time + duration.value(31, 'd')
            && get(/databases/$(database)/documents/users/$(uid)/dailyReward/status).data.membershipApplied == false
            && getAfter(/databases/$(database)/documents/users/$(uid)/dailyReward/status).data.membershipApplied == true
            && getAfter(/databases/$(database)/documents/users/$(uid)/dailyReward/status).data.claimed == true
            && getAfter(/databases/$(database)/documents/users/$(uid)/dailyReward/status).data.streak >= 30
          );
        allow update: if isSuperAdmin()
          || (
            signedIn()
            && request.auth.uid == uid
            && documentId == "status"
            && request.resource.data.plan == "vip"
            && request.resource.data.vip == true
            && request.resource.data.active == true
            && request.resource.data.source == "30-day-login-reward"
            && request.resource.data.vipExpiry > resource.data.vipExpiry + duration.value(29, 'd')
            && request.resource.data.vipExpiry < resource.data.vipExpiry + duration.value(31, 'd')
            && get(/databases/$(database)/documents/users/$(uid)/dailyReward/status).data.membershipApplied == false
            && getAfter(/databases/$(database)/documents/users/$(uid)/dailyReward/status).data.membershipApplied == true
            && getAfter(/databases/$(database)/documents/users/$(uid)/dailyReward/status).data.claimed == true
            && getAfter(/databases/$(database)/documents/users/$(uid)/dailyReward/status).data.streak >= 30
          );
        allow delete: if isSuperAdmin();
      }
    }

    // Homepage Editor: public website can read; authorized admins can publish.
    match /cineflexConfig/{documentId} {
      allow read: if true;
      allow create, update, delete:
        if hasAdminRole(["super_admin", "content_manager"]);
    }

    match /vipRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isSuperAdmin();
    }

    match /livePresence/{sessionId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lastSeenMs is int
        && request.resource.data.mediaKey is string;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lastSeenMs is int
        && request.resource.data.mediaKey is string;
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Anonymous/session-level homepage presence currently used by home.js.
    match /cineflex_presence/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.lastActiveMs is int;
      allow delete: if isAdmin();
    }

    match /cineflex_title_activity/{titleKey} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /cineflex_activity/{activityId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /cineflex_reactions/{titleKey} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();

      match /users/{uid} {
        allow read: if signedIn();
        allow create, update, delete:
          if signedIn() && request.auth.uid == uid;
      }
    }

    match /cineflex_comments/{titleKey} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();

      match /items/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if signedIn()
          && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    match /cineflex_comment_stats/{titleKey} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    match /cineflex_ratings/{titleKey} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if isAdmin();

      match /users/{uid} {
        allow read: if true;
        allow create, update, delete:
          if signedIn() && request.auth.uid == uid;
      }
    }

    match /watchPartyRooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.hostUid == request.auth.uid;

      match /members/{uid} {
        allow read: if signedIn();
        allow create, update, delete:
          if signedIn() && request.auth.uid == uid;
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 280;
        allow update, delete: if false;
      }
    }

    match /cineflexAdmins/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isOwner();
    }

    match /userModeration/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      allow create, update:
        if hasAdminRole(["super_admin", "moderator", "support"]);
      allow delete:
        if hasAdminRole(["super_admin", "moderator"]);
    }

    match /adminAuditLogs/{logId} {
      allow read:
        if hasAdminRole(["super_admin", "moderator", "support"]);
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /contentRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /brokenLinkReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /cineflexNotifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /importedContent/{contentId} {
      allow read: if true;
      allow create, update, delete:
        if hasAdminRole(["super_admin", "content_manager"]);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
